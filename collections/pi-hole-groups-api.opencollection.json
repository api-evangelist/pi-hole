{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pi-hole REST Auth Groups API",
    "version": "6.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-FTL-SID",
      "value": "{{X-FTL-SID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{piHoleHost}/api/groups"
          },
          "docs": "List groups"
        },
        {
          "info": {
            "name": "Create a group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{piHoleHost}/api/groups",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a group"
        },
        {
          "info": {
            "name": "Delete a group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://{piHoleHost}/api/groups/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a group"
        }
      ]
    }
  ],
  "bundled": true
}