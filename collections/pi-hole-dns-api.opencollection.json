{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pi-hole REST Auth DNS API",
    "version": "6.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-FTL-SID",
      "value": "{{X-FTL-SID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DNS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current DNS blocking status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{piHoleHost}/api/dns/blocking"
          },
          "docs": "Get current DNS blocking status"
        }
      ]
    }
  ],
  "bundled": true
}